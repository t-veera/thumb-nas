# Build settings for thumb-nas. This file IS tracked in git; the generated
# sdkconfig is not. Delete sdkconfig and rebuild for changes here to apply.

# --- FAT long filename support ---
# Without these, FATFS returns DOS 8.3 short names ("KART_2~1.CSV"), which makes
# a mounted WebDAV drive show mangled filenames. LFN_HEAP keeps the 255-byte
# working buffer off the stack.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Interpret filenames as UTF-8 rather than a DOS codepage, so non-ASCII names
# survive the round trip through WebDAV.
CONFIG_FATFS_API_ENCODING_UTF_8=y

# --- Flash size and partitioning ---
# The chip is 32MB (GigaDevice c8:4019, confirmed via `esptool flash_id`).
# This was previously left at ESP-IDF's 2MB default, which capped the app
# partition at 1MB -- the real cause of the "94% full" warning, not capacity.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"

# Custom table: single 4MB app, no OTA. See partitions.csv for the layout.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- HTTPS ---
# Depends on ESP_TLS_USING_MBEDTLS and MBEDTLS_TLS_SERVER, both default y.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y

# --- HTTP server ---
# WebDAV registers one handler per method against a wildcard URI.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
