# Build settings for thumb-nas. This file IS tracked in git; the generated
# sdkconfig is not. Delete sdkconfig and rebuild for changes here to apply.

# --- FAT long filename support ---
# Without these, FATFS returns DOS 8.3 short names ("KART_2~1.CSV"), which makes
# a mounted WebDAV drive show mangled filenames. LFN_HEAP keeps the 255-byte
# working buffer off the stack.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Interpret filenames as UTF-8 rather than a DOS codepage, so non-ASCII names
# survive the round trip through WebDAV.
CONFIG_FATFS_API_ENCODING_UTF_8=y

# --- HTTPS ---
# Depends on ESP_TLS_USING_MBEDTLS and MBEDTLS_TLS_SERVER, both default y.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y

# --- HTTP server ---
# WebDAV registers one handler per method against a wildcard URI.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
