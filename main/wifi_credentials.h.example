/*
  Template for wifi_credentials.h.

  Copy this file to wifi_credentials.h in the same directory and fill in your
  own network details. wifi_credentials.h is gitignored; this template is the
  only one that gets committed, so keep the placeholders here as placeholders.

    copy main\wifi_credentials.h.example main\wifi_credentials.h

  The board joins as a 2.4 GHz station -- if your router runs a separate
  5 GHz-only SSID, use the 2.4 GHz one here.
*/
#pragma once

#define WIFI_SSID     "YOUR_WIFI_NAME"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

/* WebDAV login, prompted for when you mount the drive. Sent as HTTP Basic
   auth, which is base64 -- readable by anyone on the wire. That is only
   acceptable because this server is HTTPS-only; never expose it over plain
   HTTP. */
#define WEBDAV_USER   "YOUR_WEBDAV_USERNAME"
#define WEBDAV_PASS   "YOUR_WEBDAV_PASSWORD"
